  font-family: var(--font-game);
  background: repeating-linear-gradient(
    45deg,
    #202020 0px,
    #202020 10px,
    #252525 10px,
    #252525 20px
  );
  color: var(--text-main);
  font-size: 12.75px;
  overflow: auto;
}
h1,
h2,
h3,
h4,
h5,
h6 {
  margin-top: 0;
  margin-bottom: 0.5em;
}
/* --- Interactive Elements --- */
button {
  font-family: inherit;
  font-size: inherit;
  cursor: pointer;
  transition:
    transform 0.1s,
    box-shadow 0.1s;
}
button:active {
  box-shadow: 0 0 20px white;
  transform: scale(1.05);
}
/* ==========================================================================
2. CORE GRID SYSTEM
========================================================================== */
.game-layout {
  display: grid;
  height: 100vh;
  width: 100%;
  gap: 12px;
  padding: 12px;
  grid-template-columns: 240px minmax(400px, 1fr) 240px;
  grid-template-rows: 100px 1fr auto;
  grid-template-areas:
    "header reset stats"
    "nav    main  stats"
    "footer footer footer";
}
/* Map panels to layout tracks */
.header-box {
  grid-area: header;
}
.reset-box {
  grid-area: reset;
}
.nav-box {
  grid-area: nav;
}
.main-box {
  grid-area: main;
}
.stats-box {
  grid-area: stats;
}
.footer-box {
  grid-area: footer;
}
/* Consolidated panel styles */
.header-box,
.reset-box,
.nav-box,
.main-box,
.stats-box,
.footer-box {
  background: var(--bg-primary);
  border: 2px solid var(--border-color);
  border-radius: 6px;
  padding: 12px;
  overflow: auto;
}
/* ==========================================================================
3. INTERNAL INTERFACE & TAB LAYOUTS
========================================================================== */
.nav-box {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.nav-box button {
  text-align: left;
  width: 100%;
  background: var(--bg-button);
  color: #fff;
  border: 1px solid transparent;
  border-radius: 6px;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    transform 0.1s ease;
  padding: 6px 10px;
  font-size: 16px;
  font-weight: 600;
}
.nav-box img,
.stats-box img,
#amoebaButton img {
  width: 42px;
  height: 42px;
  aspect-ratio: 1 / 1;
  border: 2px solid #ffffff;
}
/* Gameplay View Split */
.gameplay-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 12px;
}
/* Upgrades Matrix */
.upgrade-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 10px;
  padding: 16px;
}
.upgrade-card {
  position: relative;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 10px;
  cursor: pointer;
  user-select: none;
  background: var(--bg-secondary);
}
.upgrade-card .details {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-8px);
  transition:
    max-height 0.3s ease,
    opacity 0.3s ease,
    transform 0.3s ease;
}
.upgrade-card:hover .details {
  max-height: 200px;
  opacity: 1;
  transform: translateY(0);
}
.stats-box {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.stats-box p {
  margin: 4px 0;
}
/* ==========================================================================
4. PROGRESS FOOTER STYLING
========================================================================== */
.footer-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.progress-container {
  width: 100%;
  max-width: 600px;
  height: 20px;
  background: #222;
  border: 3px solid #c9c9c9;
  border-radius: 10px;
  overflow: hidden;
  position: relative;
}
.progress-bar {
  width: 0%;
  height: 100%;
  background: var(--accent-blue);
  transition: width 0.2s ease;
}
/* ==========================================================================
5. SPECIFIC UPGRADE & ENTITY UTILITIES
========================================================================== */
.cell {
  width: 67px;
  height: 67px;
  border-radius: 50%;
  box-shadow: 0 0 0 3px #c2c2c2;
  background-color: #f0f0f0;
}
#cellResetBtn {
  background-color: #1d1818;
  color: rgb(21, 154, 221);
  border-color: rgb(21, 154, 221);
  padding: 8px 12px;
  border-radius: 4px;
}
#slamo img {
  width: 42px;
  height: 42px;
  aspect-ratio: 1 / 1;
  border: 2px solid #202020;
}
.slamo-row {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}
.slamo-row > * {
  flex: 1;
  min-width: 0;
}
.upgrade-card.unlock {
  background-color: #f5d547;
  border-color: #bd9f09;
  color: #1a1a2e;
}
.upgrade-card.optional {
  background: repeating-linear-gradient(
    45deg,
    #b84141 0px,
    #b84141 10px,
    darkred 10px,
    darkred 12px
  );
  background-color: #ce5050;
  border-color: #a94848;
}
/* ==========================================================================
6. TYPOGRAPHY & VISIBILITY HELPERS
========================================================================== */
#dnaContent {
  display: flex;
  gap: 30px;
}
.panel-heading {
  font-size: 1rem;
  font-weight: 700;
}
.panel-subheading {
  margin-top: 14px;
  font-size: 0.9rem;
}
.subtitle {
  font-weight: 400;
  margin: 0;
}
.normal-weight {
  font-weight: normal;
}
.medium-heading {
  font-size: 0.85rem;
}
.aggressivenessUpgrade {
  color: rgb(255, 53, 53);
}
.activeUpgrade {
  color: rgba(88, 240, 88, 0.872);
}
.idleUpgrade {
  color: rgb(77, 154, 255);
}
.hide {
  display: none !important;
}
/* ==========================================================================
7. RESPONSIVE MEDIA QUERIES
========================================================================== */
@media (max-width: 800px) {
  .game-layout {
    height: auto;
    grid-template-columns: 1fr;
    grid-template-rows: repeat(6, auto);
    grid-template-areas:
      "header"
      "reset"
      "nav"
      "main"
      "stats"
      "footer";
  }
  .nav-box {
    flex-direction: row;
    flex-wrap: wrap;
  }
  .nav-box button {
    width: auto;
  }
  .slamo-row {
    flex-direction: column;
  }
}
.resource-container {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #252525;
  border: 1px solid #444;
  border-radius: 6px;
  padding: 8px 12px;
  margin-bottom: 8px;
}
.resource-container p {
  margin: 0;
  font-size: 13.5px;
  font-weight: bold;
}
</file>

