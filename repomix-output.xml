  }
  if (levelOf(state, u20.ID) >= 1) {
    cellResetBtn.textContent = `Reset everything, in exchange for \n
${getRNABurst(state)} RNA. Additionally, unlocks ${checkREUnlocks(state, reThresholds)}`;
