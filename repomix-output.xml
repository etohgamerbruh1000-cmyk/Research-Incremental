export const doc = <T extends HTMLElement = HTMLElement>(id: string): T => {
  const element = document.getElementById(id);
  if (!element) {
    throw new Error(`Element with id "${id}" not found.`);
  }
  return element as T;
};

//* Main function
export function render(state: State) {
  renderStats(state);
}

export function renderAllUpgrades(state: State) {
  Object.values(upgradeLibrary).forEach((upgrade) => {
    renderUpgrade(state, upgrade);
