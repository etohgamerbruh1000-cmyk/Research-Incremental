{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true, // Crucial: Allows JS files to exist
    "checkJs": true, // Crucial: Skips type-checking old JS files
    "strict": true, // Ensures strict checking on new TS files
    "noEmit": true, // Uses TS only for linting/type-checking
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["modules/**/*", "app.ts"], // Point this to your source directory
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.zip",
    "**/*.xml"
  ]
}
